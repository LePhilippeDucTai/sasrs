==== LOG ====

1     data q;
2       length q1 q2 q3 q4 q5 q6 $12;
3       /* quote resolves x first then masks the semicolon so it stays literal */
4       q1 = "Z;y";
5       /* an unpaired open paren, escaped so the call still bounds correctly */
6       q2 = "a(b";
7       /* nrquote also masks the still-undefined z reference in the result */
8       q3 = "a&z b";
9       /* superq never resolves - w holds the literal two characters x-ref */
10      q4 = "&x";
11      /* bquote behaves like quote here, without requiring percent escapes */
12      q5 = "Z;y";
13      /* nrbquote also masks the undefined z reference, like nrquote */
14      q6 = "a&z b";
